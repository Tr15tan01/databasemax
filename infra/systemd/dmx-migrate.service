# Database migrations (run by deploy.sh before services restart). Same user, environment and
# sandbox as the API, but with the migration (schema owner) credentials.
[Unit]
Description=DatabaseMax control-database migrations
After=postgresql.service

[Service]
Type=oneshot
User=dmx-api
Group=dmx-api
WorkingDirectory=/opt/databasemax/apps/api
EnvironmentFile=/etc/databasemax/env/api.env
EnvironmentFile=/etc/databasemax/env/migrate.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/databasemax/apps/api/.venv/bin/alembic upgrade head
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
