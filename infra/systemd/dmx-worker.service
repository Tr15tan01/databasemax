[Unit]
Description=DatabaseMax worker (provisioning jobs, backups, metrics, email)
After=network-online.target postgresql.service redis-server.service dmx-provisioner.service
Wants=network-online.target
PartOf=databasemax.target

[Service]
Type=exec
User=dmx-api
Group=dmx-api
WorkingDirectory=/opt/databasemax/apps/api
EnvironmentFile=/etc/databasemax/env/api.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DMX_WORKER_CONCURRENCY=4
ExecStart=/opt/databasemax/apps/api/.venv/bin/python -m app.workers.runner
Restart=always
RestartSec=3
TimeoutStopSec=60
MemoryMax=512M
CPUQuota=75%
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=-/var/lib/databasemax/mail
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=databasemax.target
