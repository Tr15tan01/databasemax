[Unit]
Description=DatabaseMax web app (Next.js)
After=network-online.target dmx-api.service
Wants=network-online.target
PartOf=databasemax.target

[Service]
Type=exec
User=dmx-web
Group=dmx-web
WorkingDirectory=/opt/databasemax/apps/web/.next/standalone
EnvironmentFile=/etc/databasemax/env/web.env
ExecStart=/usr/bin/node apps/web/server.js
Restart=always
RestartSec=3
MemoryMax=768M
CPUQuota=75%
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CacheDirectory=databasemax/web
CacheDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=databasemax.target
