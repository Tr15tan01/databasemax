[Unit]
Description=DatabaseMax public API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
PartOf=databasemax.target

[Service]
Type=exec
User=dmx-api
Group=dmx-api
WorkingDirectory=/opt/databasemax/apps/api
EnvironmentFile=/etc/databasemax/env/api.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/databasemax/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 3 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=3
MemoryMax=1G
CPUQuota=100%
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=-/var/lib/databasemax/mail
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=databasemax.target
