[Unit]
Description=DatabaseMax internal API (gateway routing)
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=databasemax.target

[Service]
Type=exec
User=dmx-api
Group=dmx-api
WorkingDirectory=/opt/databasemax/apps/api
EnvironmentFile=/etc/databasemax/env/api.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/databasemax/apps/api/.venv/bin/uvicorn app.internal_main:app --host 127.0.0.1 --port 8001 --workers 2 --no-server-header
Restart=always
RestartSec=3
MemoryMax=384M
CPUQuota=50%
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=databasemax.target
